# --- Supabase 데이터 접근 (설정하면 DB 모드, 비우면 로컬 파일 모드로 자동 폴백) ---
# 서버 전용. NEXT_PUBLIC_ 접두사 절대 붙이지 말 것 (클라이언트로 새어나감).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Supabase Auth / Google 로그인 (프로덕션 필수) ---
# 이 둘이 없으면 인증이 꺼지고 DEV_USER_ID 단일 사용자로 폴백한다.
# (NODE_ENV=production 이면 폴백하지 않고 에러를 낸다.)
# anon 키는 공개돼도 되는 키다 — service_role 키와 헷갈리지 말 것.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- 토큰 암호화 키 (필수, 프로덕션) ---
# 32바이트 = hex 64자. 생성: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY=

# --- 로컬 개발 폴백용 단일 사용자 ID (NEXT_PUBLIC_SUPABASE_* 미설정일 때만 사용) ---
DEV_USER_ID=dev-user

# --- 구독/체험 ---
TRIAL_DAYS=14
PLAN_PRICE_KRW=4900

# --- 포트원(PortOne) 정기결제 ---
# MOCK_BILLING=1 이거나 PORTONE_API_SECRET 미설정이면 목(mock) 모드로 동작(로컬 테스트).
MOCK_BILLING=1
PORTONE_STORE_ID=
PORTONE_API_SECRET=
PORTONE_WEBHOOK_SECRET=
# 브라우저 SDK용 (클라이언트 노출 OK) — 카드 등록/빌링키 발급에 사용
NEXT_PUBLIC_PORTONE_STORE_ID=
NEXT_PUBLIC_PORTONE_CHANNEL_KEY=

# --- 정기결제 갱신 크론 보호 ---
CRON_SECRET=

# --- 브라우저 확장 설치 링크 (Chrome 웹스토어 Unlisted URL) ---
# 미설정 시 가이드 페이지가 "곧 제공" 상태로 표시된다.
NEXT_PUBLIC_EXTENSION_URL=

# --- 운영 알림 (Slack) ---
# Slack → 앱 만들기 → Incoming Webhooks 활성화 → 채널 선택 → 발급 URL을 넣는다.
# 미설정이면 알림을 보내지 않는다(에러 없음). 무료 Pro 전환 시 알림이 온다.
SLACK_NOTIFY_WEBHOOK_URL=

# --- 한시 무료 정책 ---
# 1 이면 대시보드 구독 버튼이 결제 페이지로 가지 않고 /api/subscription/free-upgrade 로
# 바로 Pro를 부여한다(해외 결제 준비 전 임시). 값을 내리면 Groble 결제 흐름이 복구된다.
# ⚠️ 돈을 받지 않고 유료 등급을 주는 스위치다. 서버 라우트도 이 값으로 게이트되며
#    미설정 시 403(fail-closed).
NEXT_PUBLIC_FREE_PRO=1
# 한 번 클릭에 부여할 기간(일). 기간제로 두어 정책 종료 후 영구 Pro가 남지 않게 한다.
FREE_PRO_DAYS=30

# --- 외부 결제 페이지 (Groble) ---
# 대시보드 구독 버튼이 이 링크를 새 탭으로 연다.
NEXT_PUBLIC_PAYMENT_URL=https://www.groble.im/payment/QwqnFS

# --- Groble 웹훅 ---
# Groble은 서명 헤더를 주지 않으므로 URL에 붙인 비밀값으로 인증한다.
# 등록할 URL: https://<도메인>/api/webhooks/groble?key=<이 값>
# 생성: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# ⚠️ 미설정이면 웹훅이 503으로 거부된다(의도된 fail-closed).
GROBLE_WEBHOOK_SECRET=

# Groble 대시보드가 발급해 준 "웹훅 시크릿 키"를 그대로 넣는다.
# 헤더에 시크릿을 그대로 실어 보내는 방식 / 본문 HMAC-SHA256 서명 방식 둘 다 검증한다.
# URL 비밀값과 이 서명 중 하나라도 통과하면 수락한다(실제 방식 확인 후 서명만 남길 예정).
GROBLE_SIGNING_SECRET=

# 1로 두면 인증 실패한 웹훅 요청의 헤더/본문을 payment_events 에 기록한다
# (event_type='debug_unauthorized'). Groble이 어떤 헤더로 서명을 보내는지 확인할 때만
# 잠깐 켜고 끌 것 — 구독에는 절대 반영하지 않지만 아무나 행을 쌓을 수 있다.
GROBLE_WEBHOOK_DEBUG=

# --- 정기결제 해지 페이지 ---
# 구매자가 스스로 해지할 수 있는 URL(Groble 구매내역 등). 미설정 시 결제 페이지로
# 보낸다. 정기결제는 사용자가 스스로 해지할 수단 제공이 필수다.
NEXT_PUBLIC_CANCEL_URL=

# --- SEO ---
# canonical/sitemap/OG 에 쓰이는 사이트 주소. 커스텀 도메인을 붙이면 이 값을 바꾸고
# 재배포한다(빌드타임에 박힌다). 틀리면 검색엔진이 엉뚱한 주소를 색인한다.
NEXT_PUBLIC_SITE_URL=https://green-bean-nu.vercel.app

# 소유확인 메타태그. 값이 없으면 태그가 출력되지 않는다.
# 구글: Search Console → 속성 추가 → HTML 태그 방식의 content 값
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# 네이버: 서치어드바이저 → 사이트 등록 → HTML 태그 방식의 content 값
NEXT_PUBLIC_NAVER_SITE_VERIFICATION=

# 정식 개발 요청 알림용 Slack Incoming Webhook URL (없으면 알림 skip)
SLACK_WEBHOOK_URL=
